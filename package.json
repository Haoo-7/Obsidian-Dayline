{
  "name": "dayline",
  "private": true,
  "version": "2.5.0",
  "description": "Dayline Obsidian plugin source and test tooling",
  "author": "Haoo",
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
